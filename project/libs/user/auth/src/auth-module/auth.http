# Create a new user
POST http://localhost:3000/api/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "neo@notfound.local",
  "firstname": "Tomas",
  "lastname": "Anderson",
  "password": "1234567"
}

###

# Get user by ID
GET http://localhost:3000/api/auth/b1c44fee-0272-4ce9-b2f9-0619dee7219c HTTP/1.1

###

# Login user by email and password
POST http://localhost:3000/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "neo@notfound.local",
  "password": "1234567"
}

###
