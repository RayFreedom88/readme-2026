# Create a text post
POST http://localhost:3333/api/posts HTTP/1.1
Content-Type: application/json

{
  "type": "text",
  "authorId": "658170cbb954e9f5b905ccf4",
  "tags": ["books", "nestjs"],
  "title": "Hello Neo from Zion city",
  "announce": "Follow the white rabbit through the matrix of our world today.",
  "text": "There is no spoon. The matrix is a system, Neo. That system is our enemy and we must understand it before we can change anything."
}

###

# Create a video post
POST http://localhost:3333/api/posts HTTP/1.1
Content-Type: application/json

{
  "type": "video",
  "authorId": "658170cbb954e9f5b905ccf4",
  "title": "Hello Neo from Zion city",
  "videoUrl": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
}

###

# Get published posts
GET http://localhost:3333/api/posts HTTP/1.1

###

# Get published posts with filters
GET http://localhost:3333/api/posts?type=text&tag=books&sort=likes&page=1&limit=25 HTTP/1.1

###

# Get post by ID
GET http://localhost:3333/api/posts/6d308040-96a2-4162-bea6-2338e9976540 HTTP/1.1

###

# Get missing post
GET http://localhost:3333/api/posts/00000000-0000-4000-8000-000000000000 HTTP/1.1

###

# Get drafts
GET http://localhost:3333/api/posts/drafts?authorId=658170cbb954e9f5b905ccf4 HTTP/1.1

###

# Update post
PATCH http://localhost:3333/api/posts/6d308040-96a2-4162-bea6-2338e9976540?authorId=658170cbb954e9f5b905ccf4 HTTP/1.1
Content-Type: application/json

{
  "title": "Updated title about the matrix",
  "state": "draft"
}

###

# Repost a post
POST http://localhost:3333/api/posts/6d308040-96a2-4162-bea6-2338e9976540/repost?authorId=6581762309c030b503e30512 HTTP/1.1

###

# Create a comment
POST http://localhost:3333/api/posts/6d308040-96a2-4162-bea6-2338e9976540/comments HTTP/1.1
Content-Type: application/json

{
  "authorId": "6581762309c030b503e30512",
  "text": "There is no spoon after all."
}

###

# Get comments
GET http://localhost:3333/api/posts/6d308040-96a2-4162-bea6-2338e9976540/comments?page=1&limit=50 HTTP/1.1

###

# Delete a comment
DELETE http://localhost:3333/api/posts/6d308040-96a2-4162-bea6-2338e9976540/comments/00000000-0000-4000-8000-000000000000?authorId=6581762309c030b503e30512 HTTP/1.1

###

# Like a post
POST http://localhost:3333/api/posts/6d308040-96a2-4162-bea6-2338e9976540/likes HTTP/1.1
Content-Type: application/json

{
  "userId": "6581762309c030b503e30512"
}

###

# Unlike a post
DELETE http://localhost:3333/api/posts/6d308040-96a2-4162-bea6-2338e9976540/likes?userId=6581762309c030b503e30512 HTTP/1.1

###

# Delete post
DELETE http://localhost:3333/api/posts/6d308040-96a2-4162-bea6-2338e9976540?authorId=658170cbb954e9f5b905ccf4 HTTP/1.1

###
